{"name":"browser_emulate_media","description":"Emulate CSS media features for the page, for example switch between the light and dark color scheme. Omitted parameters are left unchanged; null clears an override.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"colorScheme":{"anyOf":[{"enum":["light","dark"],"type":"string"},{"type":"null"}],"description":"Emulates the prefers-color-scheme media feature"},"contrast":{"anyOf":[{"enum":["more","no-preference"],"type":"string"},{"type":"null"}],"description":"Emulates the prefers-contrast media feature"},"forcedColors":{"anyOf":[{"enum":["active","none"],"type":"string"},{"type":"null"}],"description":"Emulates the forced-colors media feature"},"media":{"anyOf":[{"enum":["screen","print"],"type":"string"},{"type":"null"}],"description":"Changes the CSS media type of the page"},"reducedMotion":{"anyOf":[{"enum":["reduce","no-preference"],"type":"string"},{"type":"null"}],"description":"Emulates the prefers-reduced-motion media feature"}},"type":"object"}}