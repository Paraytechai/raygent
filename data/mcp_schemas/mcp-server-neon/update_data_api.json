{"name":"update_data_api","description":"Updates the Neon Data API configuration for the specified branch.\n\nbranch_id is a branch id (br-...), not a branch name. Call list_branches to resolve a name.","parameters":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"branch_id":{"pattern":"^[a-z0-9-]{1,60}$","type":"string"},"database_name":{"type":"string"},"db_aggregates_enabled":{"type":"boolean"},"db_anon_role":{"type":"string"},"db_extra_search_path":{"type":"string"},"db_max_rows":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"db_schemas":{"items":{"type":"string"},"type":"array"},"jwt_cache_max_lifetime":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"jwt_role_claim_key":{"type":"string"},"openapi_mode":{"type":"string"},"project_id":{"description":"Required for an unscoped connection. May be omitted when the connection is scoped to one project; if provided, it must match that project.","pattern":"^[a-z0-9-]{1,60}$","type":"string"},"server_cors_allowed_origins":{"type":"string"},"server_timing_enabled":{"type":"boolean"}},"required":["branch_id","database_name"],"type":"object"}}